# Intake form endpoint (Formspree or any JSON-POST form service).
# Create a form at https://formspree.io and paste its URL here.
# Baked into the client bundle at build time, so it is public by design.
VITE_INTAKE_ENDPOINT="https://formspree.io/f/your_form_id"

# Live audit workbench that "Audit a tender free" opens (no trailing slash)
VITE_WORKBENCH_URL="https://antova-workbench.akhilfut.workers.dev"
